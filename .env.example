# ==============================================================================
# Autonomous AI Genomic Analysis Platform - Environment Configuration Example
# Copy this file to .env in backend/ or root and fill in your values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/genomics_db

# File Storage Configuration
UPLOAD_DIRECTORY=./data/uploads
REPORT_DIRECTORY=./data/generated_reports
MAX_UPLOAD_SIZE_MB=100

# Frontend URL (for CORS allowance)
FRONTEND_ORIGIN=http://localhost:5173

# Genome Assembly Defaults (GRCh38 recommended standard)
DEFAULT_GENOME_ASSEMBLY=GRCh38

# External Bioinformatics APIs
VEP_BASE_URL=https://rest.ensembl.org
CLINVAR_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils

# AI Explanation Service (Optional - can be configured later)
LLM_PROVIDER=none
LLM_API_KEY=your_api_key_placeholder
LLM_MODEL=gemini-1.5-flash
